# Copy to .env for local development. Everything is optional locally:
# with nothing set, codes are printed in the terminal and shown on screen,
# and data goes into a local SQLite file (data.db).

PORT=3000
NODE_ENV=development
APP_NAME="PBAT DOOR TO DOOR"

# ---- Database (needed in production) ----
# Any Postgres connection string. Leave empty to use local SQLite.
DATABASE_URL=

# ---- Email (needed in production) — the first one that is set is used ----
# Brevo: works on Render's free plan, no domain required (verify a single sender email).
BREVO_API_KEY=
# Resend: also works on Render's free plan, but needs your own verified domain.
RESEND_API_KEY=
# Gmail via Google Apps Script: free, about 100 emails/day, no domain. Setup steps in apps-script/Code.gs.
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=
# SMTP: blocked on Render's free plan; fine locally or on a paid instance.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---- Phone sign-in (needed for sign-in by phone in production) ----
# Google Firebase (recommended): Google sends the code, no Sender ID or CAC. First 10 texts a day free.
# Firebase console > Project settings > General > Your apps (Web app) shows apiKey and projectId.
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# FIREBASE_AUTH_DOMAIN=     # defaults to <projectId>.firebaseapp.com

# ---- Other SMS providers (used instead of Firebase if set) ----
# Message Central VerifyNow: NO Sender ID or CAC needed (they use their own approved senders).
# Sign up at console.messagecentral.com, then copy your Customer ID and account password.
MC_CUSTOMER_ID=
MC_PASSWORD=
# MC_FLOW=SMS               # or WHATSAPP to send the code by WhatsApp instead of SMS
# MC_EMAIL=                 # the email you signed up with (optional)

# DageSMS (dagesms.com): pay in Naira, no subscription. Their shared default Sender ID needs no CAC.
DAGESMS_API_KEY=
# DAGESMS_SENDER=DageSMS    # the shared sender name they give you, or your own approved one later
# DAGESMS_ROUTE=corporate   # transactional route: reaches DND numbers, 24/7

# Termii (Nigerian provider): API key + an approved Sender ID from your Termii dashboard.
TERMII_API_KEY=
TERMII_SENDER_ID=
# TERMII_CHANNEL=dnd        # 'dnd' reaches numbers on Do-Not-Disturb; 'generic' is cheaper but can be blocked
# TERMII_BASE_URL=https://api.ng.termii.com
# Twilio (alternative): TWILIO_FROM is a Twilio number (+1555…) or a Messaging Service SID (MG…)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Sender shown in the email, e.g.  PBAT DOOR TO DOOR <you@gmail.com>
MAIL_FROM=
